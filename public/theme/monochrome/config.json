        "select_options": {
            "light": "亮",
            "dark": "暗"
        },
        "default_value": "dark"
    }, {
        "label": "自定义页脚HTML",
        "placeholder": "可以实现客服JS代码的加入等",
        "field_name": "custom_html",
        "field_type": "textarea"
