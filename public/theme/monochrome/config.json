{
    "name": "monochrome",
    "description": "黑白灰极简主题",
    "version": "0.1.4",
    "images": "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?ixlib=rb-4.0.3&auto=format&fit=crop&w=2160&q=80",
    "configs": [{
